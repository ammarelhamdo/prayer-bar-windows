<?xml version="1.0" encoding="utf-8"?>
<!--
  Single small exe that uses the installed .NET 8 Desktop Runtime.
  dotnet publish src/PrayerBar -p:PublishProfile=FrameworkDependent
  (EnableCompressionInSingleFile is self-contained only, so it is not set here.)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
