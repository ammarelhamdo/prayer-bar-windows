<?xml version="1.0" encoding="utf-8"?>
<!--
  Single self-contained exe: runs on any Windows 10/11 x64 PC without installing .NET.
  dotnet publish src/PrayerBar -p:PublishProfile=SelfContained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native WPF DLLs are extracted at first run instead of sitting next to the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compresses the bundled runtime; costs a little startup time, saves ~half the size. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\self-contained\</PublishDir>
  </PropertyGroup>
</Project>
