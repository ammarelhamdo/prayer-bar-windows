<Window x:Class="PrayerBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات PrayerBar"
        FlowDirection="RightToLeft"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="المدينة" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CityBox" FlowDirection="LeftToRight" Margin="0,0,0,8" Padding="4,3" />

        <TextBlock Grid.Row="1" Text="الدولة" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CountryBox" FlowDirection="LeftToRight" Margin="0,0,0,8" Padding="4,3"
                 ToolTip="رمز الدولة، مثل TR أو SA" />

        <TextBlock Grid.Row="2" Text="التنبيه قبل (دقائق)" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="NotifyBox" FlowDirection="LeftToRight" Margin="0,0,0,8" Padding="4,3"
                 ToolTip="0 لإيقاف التنبيهات" />

        <TextBlock Grid.Row="3" Text="الإحداثيات" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CoordsText" FlowDirection="LeftToRight" Foreground="Gray"
                   VerticalAlignment="Center" Margin="0,0,0,8"
                   ToolTip="تُستخدم لحساب الأوقات دون اتصال. تُحدَّث تلقائياً عند تغيير المدينة." />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="StatusText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="SaveButton" Content="حفظ" MinWidth="80" Padding="10,4" Margin="0,0,8,0" IsDefault="True" Click="OnSave" />
            <Button Content="إلغاء" MinWidth="80" Padding="10,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
