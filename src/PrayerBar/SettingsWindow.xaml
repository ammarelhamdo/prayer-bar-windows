<!--
  Settings: language, country -> city, notification lead time, and an "Advanced" section
  (calculation method override, Asr school, taskbar embedding). All texts are set from code
  (Loc) so the window can switch language live; colors come from the Theme palette.
-->
<Window x:Class="PrayerBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrayerBar"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="20,16,20,20">
        <TextBlock x:Name="HeaderText" FontSize="24" FontWeight="SemiBold" Margin="2,0,0,14"
                   Foreground="{DynamicResource Brush.Text}" />

        <!-- Language -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock x:Name="LanguageLabel" Style="{StaticResource Label}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton x:Name="LangAr" Style="{StaticResource Segment}" GroupName="lang" Content="العربية"
                                 Checked="OnLanguageChanged" />
                    <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="lang" Content="English"
                                 Checked="OnLanguageChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Location -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="labels" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CountryLabel" Style="{StaticResource Label}" Margin="0,0,16,8" />
                <local:SearchPicker x:Name="CountryPicker" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="OnCountryChanged" />
                <TextBlock x:Name="CityLabel" Grid.Row="1" Style="{StaticResource Label}" Margin="0,0,16,0" />
                <local:SearchPicker x:Name="CityPicker" Grid.Row="1" Grid.Column="1" SelectionChanged="OnCityChanged" />
                <!-- Today's times for the current selection, computed offline instantly. -->
                <TextBlock x:Name="PreviewText" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SubText}"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Appearance of the taskbar label -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="LayoutLabel" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="LayoutTwo" Style="{StaticResource Segment}" GroupName="layout" />
                        <RadioButton x:Name="LayoutOne" Style="{StaticResource Segment}" GroupName="layout" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="WeightLabel" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="WeightNormal" Style="{StaticResource Segment}" GroupName="weight" FontWeight="Normal" />
                        <RadioButton x:Name="WeightBold" Style="{StaticResource Segment}" GroupName="weight" FontWeight="Bold" />
                        <RadioButton x:Name="WeightExtra" Style="{StaticResource Segment}" GroupName="weight" FontWeight="Black" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Notifications -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock x:Name="NotifyLabel" Style="{StaticResource Label}" />
                <local:SearchPicker x:Name="NotifyPicker" Width="130" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- Advanced -->
        <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource Disclosure}" />
        <Border x:Name="AdvancedPanel" Style="{StaticResource Card}"
                Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock x:Name="MethodLabel" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <local:SearchPicker x:Name="MethodPicker" Margin="0,0,0,14" SelectionChanged="OnMethodChanged" />
                <DockPanel Margin="0,0,0,14">
                    <TextBlock x:Name="AsrLabel" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="AsrShafi" Style="{StaticResource Segment}" GroupName="asr" Checked="OnAsrChanged" />
                        <RadioButton x:Name="AsrHanafi" Style="{StaticResource Segment}" GroupName="asr" Checked="OnAsrChanged" />
                    </StackPanel>
                </DockPanel>
                <CheckBox x:Name="EmbedSwitch" Style="{StaticResource Switch}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="2,4,2,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
